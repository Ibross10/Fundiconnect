NODE_ENV=development
PORT=4000
JWT_SECRET=
DATABASE_FILE=./data/fundiconnect.sqlite
UPLOAD_DIR=./uploads
CLIENT_ORIGIN=http://localhost:5174
VITE_API_BASE_URL=
TRUST_PROXY=

# Per-IP sensitive API route limits (count and window in milliseconds).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REGISTRATION_RATE_LIMIT_MAX=5
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_REQUEST_RATE_LIMIT_MAX=5
PASSWORD_RESET_REQUEST_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_SUBMIT_RATE_LIMIT_MAX=10
PASSWORD_RESET_SUBMIT_RATE_LIMIT_WINDOW_MS=900000

# Production password-reset delivery (Resend). Configure and test with your provider before enabling.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_EMAIL_ENABLED=false
